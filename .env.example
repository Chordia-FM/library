# Chordia library: local dev container overrides (compose.yaml + compose.acquisition.yaml).
# Copy to `.env` (gitignored); Docker Compose reads it automatically. Every value is optional and
# the defaults match the compose files, so an empty .env works fine.

# --- Library container (compose.yaml) ---
LIBRARY_PORT=8443          # host port the library is published on
MUSIC_DIR=./music          # host path to your music (mounted read-only)
DATA_DIR=./data            # host path for the SQLite index, cache, and credentials

# --- Acquisition dev sidecars (compose.acquisition.yaml) ---
PUID=1000                  # user id the Prowlarr container runs as
PGID=1000                  # group id
TZ=Etc/UTC                 # container timezone
PROWLARR_PORT=9696         # host port for the Prowlarr web UI (bound to localhost)
FLARESOLVERR_PORT=8191     # host port for FlareSolverr (bound to localhost)
