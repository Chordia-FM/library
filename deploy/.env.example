# Library deploy environment. Copy to `.env` (gitignored). Compose reads it automatically.

# Host path to the music you want to serve, mounted at /data/music (read-write; see compose.prod.yaml).
MUSIC_DIR=/srv/music

# --- Optional container overrides (defaults shown; compose.prod.yaml works without any of these) ---
# LIBRARY_IMAGE=ghcr.io/chordia-fm/library:latest
# LIBRARY_BIND_ADDR=127.0.0.1     # set 0.0.0.0 to accept direct connections (then firewall the port)
# LIBRARY_PORT=8443               # host port the library is published on
# PUID=1000                       # uid/gid the optional acquisition sidecars run as
# PGID=1000
# PROWLARR_PORT=9696              # host ports for the optional Prowlarr / qBittorrent sidecars
# QBIT_PORT=8080

# ── Only needed for the optional edge-TLS overlay (compose.edge.yaml) ───────────────────────────
LIBRARY_DOMAIN=library.example.com
CERTBOT_EMAIL=you@example.com
# Set to 1 to use the Let's Encrypt staging CA while testing (avoids rate limits); 0 for real certs.
CERTBOT_STAGING=0
# HTTP_PORT=80                    # edge listen ports (compose.edge.yaml)
# HTTPS_PORT=443
